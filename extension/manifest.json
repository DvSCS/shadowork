{
  "manifest_version": 3,
  "name": "SceneLingo — inglês, cena por cena",
  "version": "1.0.0",
  "description": "Legendas progressivas, shadowing, eco e vocabulário em players HTML5. Ative somente nas abas que você escolher.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "SceneLingo", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "web_accessible_resources": [{ "resources": ["shared/core.js", "overlay.css"], "matches": ["<all_urls>"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
