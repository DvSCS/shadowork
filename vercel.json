{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/index?__route=/manifest.json" },
    { "source": "/subtitles/:path*", "destination": "/api/index?__route=/subtitles/:path*" },
    { "source": "/auto/:path*", "destination": "/api/index?__route=/auto/:path*" },
    { "source": "/a/:path*", "destination": "/api/index?__route=/a/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__route=/api/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ]},
    { "source": "/", "headers": [
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ]}
  ]
}
